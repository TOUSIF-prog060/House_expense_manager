{
  "expo": {
    "name": "OurHome",
    "slug": "ourhome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ourhome",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121316"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ourhome.household",
      "infoPlist": {
        "NSCameraUsageDescription": "OurHome requires camera access to attach receipts to expenses.",
        "NSPhotoLibraryUsageDescription": "OurHome requires photo library access to upload receipt images and documents.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121316"
      },
      "package": "com.ourhome.household",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10b981"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OurHome requires photo library access to attach receipts to expenses."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
