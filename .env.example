# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public / Anon API Key (either name is accepted)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Service Role Secret Key (never expose to client; either name is accepted)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Web Push Notifications VAPID key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
